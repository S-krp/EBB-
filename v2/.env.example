# ALERT_WEBHOOK_URL=https://example.com/alert-receiver
# V2_BACKGROUND_REFRESH=true
# NEO4J_URI=neo4j+s://example.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
