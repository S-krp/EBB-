# PostgreSQL connection string (required on Vercel; optional on Railway/local)
DATABASE_URL=
# SQLite file when DATABASE_URL is not set
SQLITE_PATH=.data/notices.sqlite
# Vercel sends this value as a Bearer token to /api/cron
CRON_SECRET=
# Enable the in-process scheduler off Vercel; set false to disable it
ENABLE_WORKER=true
